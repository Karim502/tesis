# --- Entorno ---
ENV=dev

# --- Base de datos y Seguridad ---
DATABASE_URL=
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:5173"]

# --- Modelos y Reentrenamiento (MLOps) ---
MODELO_PATH=ml_models/modelo_ganador.joblib
ENTRENAMIENTO_CSV_PATH=data/dataset_entrenamiento.csv
ENTRENAMIENTO_TARGET=riesgo
ENTRENAMIENTO_MAX_MB=5
ENTRENAMIENTO_MIN_FILAS=60
ENTRENAMIENTO_TIMEOUT_MIN=60

# --- Almacenamiento (MLOps) ---
# Usa "local" mientras desarrollas, o "s3" si ya tienes tus claves AWS listas
STORAGE_BACKEND=s3
S3_BUCKET_NAME=modelos
S3_REGION=ca-central-1
# S3_ENDPOINT_URL=  <-- Déjalo comentado si usas AWS S3 estándar (solo se usa para R2/MinIO)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=