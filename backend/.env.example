# --- Entorno ---
# Usa "dev" en local y "prod" en Render
ENV=dev

# --- Base de datos y Seguridad ---
DATABASE_URL=
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# En prod con frontend y backend en dominios distintos (ej. Vercel + Render): COOKIE_SECURE=true y COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:5173"]

# --- Modelos y Reentrenamiento (MLOps) ---
MODELO_PATH=ml_models/modelo_ganador.joblib
ENTRENAMIENTO_CSV_PATH=data/dataset_entrenamiento.csv
ENTRENAMIENTO_TARGET=riesgo
ENTRENAMIENTO_MAX_MB=5
ENTRENAMIENTO_MIN_FILAS=60
ENTRENAMIENTO_TIMEOUT_MIN=60

# --- Almacenamiento (MLOps) ---
# Usa "local" en desarrollo sin bucket, o "s3" para AWS S3 / R2 / Supabase Storage / MinIO
STORAGE_BACKEND=s3
S3_BUCKET_NAME=modelos
S3_REGION=ca-central-1
# Obligatorio para R2/MinIO/Supabase S3; dejar vacío solo si usas AWS S3 estándar
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=