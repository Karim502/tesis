# Copia este archivo a .env (NUNCA lo subas a Git).
DATABASE_URL=postgresql+psycopg2://tesis_user:cambia_esto@localhost:5432/tesis_mype
# Genera una clave con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# En producción (HTTPS) debe ser true. En desarrollo local sin HTTPS, false.
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
